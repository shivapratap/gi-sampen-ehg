# ---------------------------------------------------------------------------
# External data. Never committed.
# ---------------------------------------------------------------------------
# The PhysioNet Icelandic 16-electrode EHG database is public but large and is
# not redistributed from here. See data/README.md.
/data/raw/
*.dat
*.hea
*.atr

# ---------------------------------------------------------------------------
# Deterministic intermediates. Regenerable from data/ + scripts/; excluded to
# keep the repository small. Everything needed to verify a manuscript claim
# lives in results/ and is tracked.
# ---------------------------------------------------------------------------
/work/

# ---------------------------------------------------------------------------
# Tracked on purpose -- do not add results/ to this file.
#   results/tables/    manuscript tables and Figure/Table source data
#   results/figures/   final figure (pdf/png/svg) and its source CSVs
#   results/audits/    compact audit reports needed to verify manuscript claims
#   data/manifests/    lightweight derived manifests and checksums
# ---------------------------------------------------------------------------

